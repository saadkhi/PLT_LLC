# Copy to .env and fill in. Never commit .env.

# Local development uses SQLite:
DATABASE_URL="file:./dev.db"

# On Vercel, `npm run vercel-build` switches the schema to PostgreSQL and needs both:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"   # pooled connection
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"     # direct connection

# Admin login. If no admin user exists yet, logging in with these creates one.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""

# Image uploads. Without it, uploads are saved to public/uploads (works locally, not on Vercel).
BLOB_READ_WRITE_TOKEN=""
